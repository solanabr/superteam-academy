{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(cargo test *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "Bash(cargo build-sbf *)",
      "Bash(cargo audit *)",
      "Bash(solana address *)",
      "Bash(solana balance *)",
      "Bash(solana program show *)",
      "Bash(solana account *)",
      "Bash(solana program dump *)",
      "Bash(solana-test-validator *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git fetch *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git pull *)",
      "Bash(git checkout *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr create *)"
    ],
    "deny": [
      "Bash(git config user.*)",
      "Bash(git config --local user.*)",
      "Bash(git config --worktree user.*)",
      "Bash(git config --global user.*)",
      "Bash(git config set *user.*)",
      "Bash(git -c user.*)",
      "Bash(git add -A*)",
      "Bash(git add --all*)",
      "Bash(git add .)",
      "Bash(git push * main)",
      "Bash(git push *:main)",
      "Bash(git push *:refs/heads/main)",
      "Bash(solana config get*)",
      "Bash(solana config set*)",
      "Bash(sudo *)",
      "Read(/apps/web/src/content/generated/l10n.json)",
      "Read(/apps/web/src/content/generated/lessons.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git *)",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-git.mjs\"",
            "timeout": 15,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(*solana*program*)",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-solana.mjs\"",
            "timeout": 15,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(*gh pr merge*)",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-merge.mjs\"",
            "timeout": 120,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(*gh api*merge*)",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-merge.mjs\"",
            "timeout": 120,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
