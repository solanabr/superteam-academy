{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(cargo test *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "Bash(cargo build-sbf *)",
      "Bash(cargo audit *)",
      "Bash(solana address *)",
      "Bash(solana balance *)",
      "Bash(solana program show *)",
      "Bash(solana account *)",
      "Bash(solana program dump *)",
      "Bash(solana-test-validator *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git fetch *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git pull *)",
      "Bash(git checkout -b *)",
      "Bash(git switch *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr create *)"
    ],
    "deny": [
      "Bash(git config user.*)",
      "Bash(git config --local user.*)",
      "Bash(git config --worktree user.*)",
      "Bash(git config --global user.*)",
      "Bash(git config set *user.*)",
      "Bash(git -c user.*)",
      "Bash(git add -A*)",
      "Bash(git add --all*)",
      "Bash(git add .)",
      "Bash(git push * main)",
      "Bash(git push *:main)",
      "Bash(git push *:refs/heads/main)",
      "Bash(solana config get*)",
      "Bash(solana config set*)",
      "Bash(solana * config get*)",
      "Bash(solana * config set*)",
      "Bash(sudo *)",
      "Read(/apps/web/src/content/generated/l10n.json)",
      "Read(/apps/web/src/content/generated/lessons.json)",
      "Read(~/.config/solana/cli/config.yml)",
      "mcp__plugin_supabase_supabase",
      "mcp__dbd5cdaf-3f5f-4789-9ff5-decf5836df3d",
      "mcp__claude_ai_Supabase"
    ],
    "ask": [
      "Edit(/.mcp.json)",
      "Edit(~/.claude.json)",
      "mcp__*__execute_sql",
      "mcp__*__apply_migration",
      "mcp__*__run_notebook",
      "mcp__supabase-academy__execute_sql",
      "mcp__supabase-academy__apply_migration",
      "mcp__supabase-academy__run_notebook",
      "mcp__supabase-academy__create_notebook",
      "mcp__supabase-academy__delete_notebook",
      "mcp__supabase-academy__create_edge_function_secret",
      "mcp__supabase-academy__deploy_edge_function",
      "mcp__supabase-academy__create_branch",
      "mcp__supabase-academy__delete_branch",
      "mcp__supabase-academy__merge_branch",
      "mcp__supabase-academy__reset_branch",
      "mcp__supabase-academy__rebase_branch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git*)",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-git.mjs\"",
            "timeout": 15,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(*solana*)",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-solana.mjs\"",
            "timeout": 15,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(*anchor*)",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-solana.mjs\"",
            "timeout": 15,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(*gh*)",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-merge.mjs\"",
            "timeout": 120,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(*vercel*)",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-deploy.mjs\"",
            "timeout": 15,
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(*wrangler*)",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-deploy.mjs\"",
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
