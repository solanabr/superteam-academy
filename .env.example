# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key   # PRIVATE — server-only

# ── Solana ────────────────────────────────────────────────────────────────────
# PUBLIC browser RPC endpoint — inlined into the client bundle, so its key (if
# any) is visible in the browser. Use a keyless rate-limited public endpoint, or
# a Helius key DOMAIN-RESTRICTED in the dashboard (Allowed Origins = the app's
# domains only, e.g. https://www.stacademy.org + http://localhost:3000) so a
# leaked copy can't be used off-domain. Must be a SEPARATE key from SOLANA_RPC_URL.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# SERVER-ONLY RPC endpoint — never sent to the browser (`server-only` enforced).
# Use a SEPARATE, UNRESTRICTED Helius key here: server calls send no browser
# Origin, so an origin-restricted key would fail every request. Required: a
# missing value fails loudly at boot instead of silently using public devnet.
SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_UNRESTRICTED_KEY
# devnet | mainnet-beta (`mainnet` works too; any case). Compared only through
# isMainnetLabel()/clusterFromLabel() in apps/web/src/lib/solana/network.ts.
NEXT_PUBLIC_SOLANA_NETWORK=devnet
# In-lesson program deploy (deploy panel + devnet funding card). Off unless
# "true", and always off on mainnet, where it would spend the learner's real
# SOL. With it off, those lesson blocks show a notice and /api/deploy/save
# refuses.
NEXT_PUBLIC_LEARNER_DEPLOY_ENABLED=true

# On-chain program (see docs/DEPLOY-PROGRAM.md for deployment guide)
NEXT_PUBLIC_PROGRAM_ID=                    # Deployed program id (docs/DEPLOY-PROGRAM.md)
NEXT_PUBLIC_XP_MINT_ADDRESS=               # XP mint pubkey (from onchain-academy/scripts/init-program.ts initialize)

# ── Helius ───────────────────────────────────────────────────────────────────
# Server-only API key for Helius webhook management (scripts/helius-webhook-config.ts).
# The same unrestricted key embedded in the server-only SOLANA_RPC_URL above —
# never the browser key.
HELIUS_API_KEY=
# Shared secret for Helius webhook Authorization header validation
HELIUS_WEBHOOK_SECRET=

# ── AI lesson assistant (optional — server-only) ──────────────────────────────
# Google Gemini API key for the AI chat/suggest routes (apps/web/src/app/api/ai/*).
# Omit to disable the in-lesson AI assistant.
GEMINI_API_KEY=

# Optional dedicated key for sealing the AI Partner comprehension-check token
# (apps/web/src/lib/ai/check-seal.ts). If unset, the seal key derives from
# SUPABASE_SERVICE_ROLE_KEY instead — safe since that key is always present
# and high-entropy, but a dedicated secret here lets the seal key rotate
# independently of the service-role key.
AI_PARTNER_SEAL_SECRET=

# Set to "1" to log per-call prompt-cache token counts from /api/ai/partner.
AI_PARTNER_DEBUG=

# Best-effort AI reply on /api/lessons/reflect for openEnded reflections. On by
# default; "0" turns it off. Needs GEMINI_API_KEY.
OPENENDED_AI_REPLY=

# AI tutor daily spend caps in USD, per America/Sao_Paulo day, enforced by the
# ai_spend_ledger (lib/ai/spend-ledger.ts). Over a SOFT cap the tutor degrades
# (shorter output); a HARD cap denies with 503. Unset uses the defaults in
# apps/web/src/lib/env.server.ts.
AI_SPEND_GLOBAL_SOFT_USD=
AI_SPEND_GLOBAL_HARD_USD=
AI_SPEND_ACCOUNT_SOFT_USD=
AI_SPEND_ACCOUNT_HARD_USD=
AI_SPEND_IP_SOFT_USD=
AI_SPEND_IP_HARD_USD=
# Emergency all-models price override in $/1M tokens. Leave unset: the ledger
# prices each call at its routed model's rates (MODEL_RATES in lib/ai/models.ts).
AI_SPEND_INPUT_USD_PER_MTOK=
AI_SPEND_OUTPUT_USD_PER_MTOK=

# Per-action Gemini model overrides; defaults live in lib/ai/models.ts. A model
# outside the priced set is ignored with a warning, since the ledger can't bill it.
AI_MODEL_HINT=
AI_MODEL_ASK=
AI_MODEL_PROPOSE=
AI_MODEL_REVIEW=
AI_MODEL_SOCRATIC=
AI_MODEL_REFLECTION=

# ── Rust playground (optional — server-only) ─────────────────────────────────
# Upstream for /api/rust/execute. Defaults to https://play.rust-lang.org/execute
# when unset (apps/web/src/app/api/rust/execute/route.ts).
RUST_PLAYGROUND_URL=

# ── Dynamic embedded wallets (optional) ──────────────────────────────────────
# Environment id from the Dynamic dashboard (https://app.dynamic.xyz). Public
# and origin-bound: it ships in the client bundle by design, and the
# dashboard's allowed-origins list is what scopes it — configuration, not a
# secret. Unset = embedded wallets OFF; SIWS stays the guaranteed way in.
#
# DEPLOY WARNING: NEXT_PUBLIC_* is inlined at BUILD time — changing this on
# Vercel requires a redeploy with build cache DISABLED, or the served bundle
# silently keeps the old value (this exact trap caused a live incident).
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=

# ── Analytics (optional — platform works without these) ───────────────────────
# Google Analytics 4
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry — error + performance monitoring (client + server + edge).
# The DSN is public/safe to expose: it only identifies the project to ingest
# events, it cannot read data. Used by the instrumentation files; leave unset to
# disable Sentry entirely (the SDK no-ops). Ingest host is *.ingest.sentry.io,
# already allowed by the CSP connect-src in apps/web/next.config.mjs.
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Optional — source-map upload at build time (CI/Vercel). Server-only; omit for
# local builds. Create an auth token at sentry.io → Settings → Auth Tokens.
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
SENTRY_AUTH_TOKEN=

# ── Build Server (GCP Cloud Run) ──────────────────────────────────────────────
# Direct Cloud Run URL (IAM check disabled, app validates X-API-Key)
BUILD_SERVER_URL=https://academy-build-server-HASH.a.run.app
# API key for X-API-Key header (same value as ACADEMY_API_KEY on Cloud Run)
BUILD_SERVER_API_KEY=                      # PRIVATE — server-only

# ── App URL (sitemap, OG tags, email links, on-chain NFT metadata URI) ───────
# REQUIRED. Validated in apps/web/src/lib/env.ts: dev/test fall back to the
# localhost origin below, but a PRODUCTION build with this unset FAILS at boot —
# an empty value would pin a *relative* metadata URI into an immutable
# credential NFT. It is the only origin metadata URIs written on-chain are built
# from (achievement types, course collections, credential fallbacks), so set it
# to the final public https origin before creating anything on-chain. Those
# writes refuse a localhost origin unless SOLANA_RPC_URL is a local validator.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Arweave / Irys — permanent credential metadata (server-only) ─────────────
# At credential mint, certificate metadata is pinned to Arweave via Irys so the
# on-chain Metaplex Core asset URI resolves independently of app uptime
# (apps/web/src/lib/solana/arweave.ts). The uploader returns an Irys GATEWAY URL
# (https://gateway.irys.xyz/<id>) — NOT https://arweave.net/<txid> — and that is
# the exact string written on-chain. On mainnet the data settles on Arweave, so
# the same <id> is also reachable via https://arweave.net/<id> and ar://<id>.
# If unset, mint falls back to the app-served /api/certificates/metadata URL
# (logs a warning) — minting still works, but issued credentials will NOT
# resolve if the app is offline.
#
# Value: 64-element JSON array of a SOLANA keypair's secret-key bytes (same
# shape as BACKEND_SIGNER_SECRET). Irys is funded with this wallet's SOL — NOT
# an Arweave JWK. The human must fund it:
#   - devnet (NEXT_PUBLIC_SOLANA_NETWORK=devnet): uses https://devnet.irys.xyz,
#     free, but uploads are pruned after ~60 days — NOT truly permanent.
#   - mainnet (NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta or mainnet): uses
#     https://uploader.irys.xyz, permanent, paid in SOL from this wallet's Irys
#     balance (top up at irys.xyz before mainnet minting).
ARWEAVE_UPLOADER_SECRET=

# ── Admin operations (server-only — never expose to browser) ──────────────────
# JSON array of authority keypair bytes (64 elements), e.g. [12,34,...]
# This is the keypair that signed `initialize`. On devnet, same as BACKEND_SIGNER_SECRET.
PROGRAM_AUTHORITY_SECRET=
# Backend co-signer for user-triggered on-chain instructions (completeLesson, issueCredential…).
# On devnet: same value as PROGRAM_AUTHORITY_SECRET.
# On mainnet: a dedicated keypair, set on-chain via update_config.
BACKEND_SIGNER_SECRET=
# JSON array of the XP mint authority keypair bytes (64 elements). Signs XP token
# mints (apps/web/src/lib/solana/xp-mint.ts). Omit to disable on-chain XP minting.
XP_MINT_AUTHORITY_SECRET=
# Sponsor wallet, JSON array of keypair bytes (64 elements). Pays the fee and
# rent for sponsored enrollments and the fee on every other server-sent
# transaction, so learner usage is paid from one wallet
# (apps/web/src/lib/solana/sponsor.ts). Use a dedicated key, not the backend
# signer or the authority. Unset on mainnet makes those sends fail closed; on
# devnet the backend signer pays instead and the server logs SPONSOR_001.
SPONSOR_SECRET=
# Low-balance alert threshold in SOL for the sponsor and backend signer wallets,
# checked by /api/cron/onchain-queue (so it needs CRON_SECRET). Alerts go to
# MODERATION_WEBHOOK_URL and PostHog, at most once every few hours per wallet.
# Unset disables the alert.
SPONSOR_LOW_BALANCE_SOL=

# --- Content pipeline (server-only) -------------------------------------------
# Fine-grained READ token for solanabr/academy-courses. The repo is public, but
# unauthenticated GitHub is 60 req/hr per IP and flakes on Vercel — the admin
# publish-pin card (HEAD polling, ahead-by, Checks API) 503s without it.
GITHUB_TOKEN=

# --- Moderation (server-only) -------------------------------------------------
# Slack/Discord incoming-webhook URL for community-flag alerts. THE URL IS THE
# CREDENTIAL — anyone holding it can post to the channel. Optional; unset
# disables the alerts.
MODERATION_WEBHOOK_URL=

# --- Teacher course preview (server-only) -------------------------------------
# Shared password for /teach/preview. No default: unset disables the preview
# (/api/teach/preview/auth returns 503). It gates read-only rendering of
# unpublished course PRs only, never on-chain writes or the admin surface.
TEACH_PREVIEW_PASSWORD=

# --- Email (server-only) ------------------------------------------------------
# Resend key for announcement and reminder email. Unset sends nothing: the
# pipeline returns "unconfigured" (lib/email/resend.ts).
RESEND_API_KEY=
# Verified From identity; falls back to DEFAULT_EMAIL_FROM in lib/email/resend.ts.
EMAIL_FROM=

# --- Vercel Cron (server-only) ------------------------------------------------
# Vercel sends it as `Authorization: Bearer $CRON_SECRET`. Unset makes every
# /api/cron/* route fail closed with 503, so scheduled jobs don't run.
CRON_SECRET=
